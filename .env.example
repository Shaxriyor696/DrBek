# DrStudy sozlamalari. Bu faylni .env nomi bilan nusxalang va qiymatlarni to‘ldiring.
PORT=3000
PUBLIC_URL=http://localhost:3000
# SQLite fayli (avtomatik yaratiladi)
DATABASE_FILE=./data/drstudy.db
# review_preview — tekshiruvdagi darslar ham ko‘rinadi (banner bilan); published_only — faqat nashr etilganlar
CONTENT_ACCESS=review_preview
# Kitob PDF fayli ("Kitobdagi sahifani ochish" va qayta import uchun)
BOOK_PDF_PATH=
# Qayta import uchun: avvalgi eslatmalar papkasi va UI topics.json
GUYTON_NOTES_DIR=
UI_TOPICS_JSON=
PYTHON_BIN=python3
# HTTPS orqasida ishlaganda 1
SECURE_COOKIES=
# AI yordamchi va to‘liq tarjima skripti uchun (bo‘sh bo‘lsa AI "ulanmagan" rejimida ishlaydi)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_FALLBACKS=on
AI_DAILY_LIMIT=50
AI_PER_MINUTE=6
# Tarjima skripti (ixtiyoriy)
TRANSLATE_MODEL=
TRANSLATE_EFFORT=medium
# Xatlar SMTP ulanmaguncha shu faylga yoziladi
MAIL_OUTBOX=./data/outbox.log
